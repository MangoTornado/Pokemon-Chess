# Copy to `.kamal/secrets` and fill in. That file is gitignored — never commit it.
#
# Kamal reads these by name because config/deploy.yml lists them under `registry:`. They are the only secrets this
# app needs: it has no third-party API and no signing key, and session tokens are generated with node:crypto and
# stored hashed, so nothing else has to be injected at runtime.

# Container registry login. For GitLab use a deploy token or a personal access token with `write_registry`;
# for Docker Hub, an access token rather than your password.
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=
